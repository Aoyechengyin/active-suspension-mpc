  "tour": [
    {
      "order": 1,
      "title": "项目概述",
      "description": "这是一个MATLAB/Simulink实现的无区域显式模型预测控制（e-MPC）系统，用于主动悬架的道路预瞄控制。核心思想是离线枚举所有最优活跃集，运行时只需函数评估，适合实时嵌入式实现。",
      "nodeIds": [
        "file:src/Step1_BuildPredictionModel.m",
        "concept:regionless-mpc"
      ]
    },
    {
      "order": 2,
      "title": "预测模型构建",
      "description": "Step1_BuildPredictionModel.m 定义四分之一车物理参数（簧载质量、非簧载质量、刚度、阻尼），构建连续时间状态空间模型，添加道路预瞄移位寄存器，离散化为26维增广状态系统。",
      "nodeIds": [
        "file:src/Step1_BuildPredictionModel.m",
        "concept:quarter-car-model"
      ]
    },
    {
      "order": 3,
      "title": "MPC矩阵构建",
      "description": "Step2_BuildMPCmatrices.m 构建状态预测矩阵Phi和Gamma，性能输出预测矩阵Psi和Upsilon，QP代价矩阵H和F，约束矩阵P、M1、M2。",
      "nodeIds": [
        "file:src/Step2_BuildMPCmatrices.m"
      ]
    },
    {
      "order": 4,
      "title": "活跃集枚举",
      "description": "Step3_RegionlessSolver.m 随机采样5000-8000个状态空间点，用quadprog求解每个QP，识别最优活跃集，计算KKT矩阵分解S、Q_Ai、q_Ai，打包为codegen安全的填充数组。",
      "nodeIds": [
        "file:src/Step3_RegionlessSolver.m",
        "concept:active-set",
        "concept:kkt-conditions"
      ]
    },
    {
      "order": 5,
      "title": "在线评估算法",
      "description": "regionless_mpc_eval.m 实现Algorithm 5：计算无约束解，检查空活跃集可行性，对每个预枚举活跃集计算对偶变量，检查对偶和原始可行性，返回第一个可行解。",
      "nodeIds": [
        "function:src/regionless_mpc_eval.m:regionless_mpc_eval",
        "concept:regionless-mpc"
      ]
    },
    {
      "order": 6,
      "title": "CarSim 2020 集成",
      "description": "src_2020/ 目录包含四轮独立控制器，支持CarSim 2020联合仿真。每轮使用独立的前后轴参数，添加俯仰补偿，支持标定模式A/B测试。",
      "nodeIds": [
        "file:src_2020/config_2020.m",
        "file:src_2020/per_corner_mpc_state_step_2020.m"
      ]
    },
    {
      "order": 7,
      "title": "权重调参",
      "description": "rho5（控制力权重）必须很小（1e-7~1e-9），否则优化器会最小化控制力而非改善舒适性。经验法则：rho * expected_value^2 各项应在同一数量级。",
      "nodeIds": [
        "file:src_2020/empc_calibration_settings_2020.m",
        "file:src_2020/road3_rho5_offline/TrainRoad3Rho5Offline_2020.m"
      ]
    }
  ]
